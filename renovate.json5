{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended'],
  semanticCommits: 'enabled',
  timezone: 'Asia/Tokyo',
  reviewers: ['Soli0222'],
  assignees: ['Soli0222'],
  labels: ['dependencies'],
  prConcurrentLimit: 15,
  prHourlyLimit: 8,
  enabledManagers: ['gomod', 'dockerfile', 'github-actions'],
  packageRules: [
    {
      matchManagers: ['gomod', 'dockerfile'],
      semanticCommitType: 'fix',
      semanticCommitScope: 'deps',
      automerge: false,
    },
    {
      matchManagers: ['gomod', 'dockerfile'],
      matchDepNames: ['go', 'golang', 'golang/go'],
      groupName: 'Go toolchain',
    },
    {
      matchManagers: ['github-actions'],
      semanticCommitType: 'chore',
      semanticCommitScope: 'deps',
      separateMinorPatch: true,
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: false,
    },
    {
      matchManagers: ['dockerfile'],
      matchDatasources: ['deb'],
      groupName: 'Chromium runtime',
      registryUrls: [
        'https://deb.debian.org/debian-security?suite=trixie-security&components=main&binaryArch=amd64',
        'https://deb.debian.org/debian?suite=trixie&components=main&binaryArch=amd64',
      ],
    },
    {matchUpdateTypes: ['major'], matchManagers: ['gomod', 'dockerfile'], automerge: false},
  ],
}

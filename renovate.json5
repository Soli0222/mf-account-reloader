{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended'],
  semanticCommits: 'enabled',
  pinDigests: false,
  timezone: 'Asia/Tokyo',
  reviewers: ['Soli0222'],
  assignees: ['Soli0222'],
  labels: ['dependencies'],
  automerge: true,
  automergeType: 'pr',
  automergeStrategy: 'squash',
  platformAutomerge: false,
  ignoreTests: false,
  prConcurrentLimit: 15,
  prHourlyLimit: 8,
  enabledManagers: ['gomod', 'dockerfile', 'github-actions'],
  customDatasources: {
    'debian-trixie': {format: 'html'},
  },
  packageRules: [
    {
      matchManagers: ['gomod', 'dockerfile'],
      semanticCommitType: 'fix',
      semanticCommitScope: 'deps',
    },
    {
      matchManagers: ['gomod', 'dockerfile'],
      matchDepNames: ['go', 'golang', 'golang/go'],
      groupName: 'Go toolchain',
    },
    {
      matchManagers: ['github-actions'],
      semanticCommitType: 'chore',
      semanticCommitScope: 'deps',
      separateMinorPatch: true,
    },
    {
      matchManagers: ['dockerfile'],
      matchDatasources: ['deb'],
      matchPackageNames: ['chromium', 'chromium-common', 'chromium-sandbox'],
      groupName: 'Chromium runtime',
      minimumGroupSize: 3,
      // Work around Renovate #44330: Debian Security publishes Packages.xz,
      // while the deb datasource only fetches Packages.gz. Keep Dockerfile's
      // native pin extraction/update; read available binaries from Debian.
      overrideDatasource: 'custom.debian-trixie',
      versioning: 'deb',
      extractVersion: '_(?<version>[^_]+)_amd64\\.deb$',
      registryUrls: [
        'https://packages.debian.org/trixie/amd64/{{packageName}}/download',
      ],
    },
  ],
}
